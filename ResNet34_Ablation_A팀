    "## 3. 비교용 VGG16 (B팀 담당 영역)\n",
    "\n",
    "ResNet vs VGG 비교 표를 한 노트북에서 만들기 위해 VGG16도 직접 구현해 둡니다. **상세 구현·분석은 B팀 담당**이며, 여기서는 비교 기준선으로만 사용합니다.\n",
    "\n",
    "VGG16은 skip connection 없이 3×3 conv를 깊게 쌓고 maxpool로 다운샘플하는 단순 직렬 구조입니다. 원본 분류기는 224 입력 기준이라 FC가 매우 큽니다. 여기서는 CIFAR 32×32에 맞춰 분류기를 가볍게 조정했습니다.\n"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "# ── 3-1. VGG16 직접 구현 (CIFAR 적응, 비교용) ──────────────────\n",
    "# 숫자 = 출력 채널, 'M' = MaxPool.  VGG16 = conv 13 + fc 3.\n",
    "VGG16_CFG = [64, 64, 'M', 128, 128, 'M', 256, 256, 256, 'M',\n",
    "             512, 512, 512, 'M', 512, 512, 512, 'M']\n",
    "\n",
    "class VGG(nn.Module):\n",
    "    def __init__(self, cfg, num_classes=10, use_bn=True):\n",
    "        super().__init__()\n",
    "        self.features = self._make_features(cfg, use_bn)\n",
    "        # 32×32 → maxpool 5번 → 1×1 (채널 512)\n",
    "        self.classifier = nn.Sequential(\n",
    "            nn.Flatten(),\n",
    "            nn.Linear(512, 512), nn.ReLU(inplace=True), nn.Dropout(0.5),\n",
    "            nn.Linear(512, num_classes),\n",
    "        )\n",
    "\n",
    "    def _make_features(self, cfg, use_bn):\n",
    "        layers, in_ch = [], 3\n",
    "        for v in cfg:\n",
    "            if v == 'M':\n",
    "                layers.append(nn.MaxPool2d(2, 2))\n",
    "            else:\n",
    "                layers.append(nn.Conv2d(in_ch, v, 3, padding=1, bias=not use_bn))\n",
    "                if use_bn:\n",
    "                    layers.append(nn.BatchNorm2d(v))\n",
    "                layers.append(nn.ReLU(inplace=True))\n",
    "                in_ch = v\n",
    "        return nn.Sequential(*layers)\n",
    "\n",
    "    def forward(self, x):\n",
    "        return self.classifier(self.features(x))\n",
    "\n",
    "def VGG16(num_classes=10, use_bn=True):\n",
    "    return VGG(VGG16_CFG, num_classes, use_bn)\n",
    "\n",
    "# 검증\n",
    "_v = VGG16(num_classes=NUM_CLASSES)\n",
    "print(\"VGG16 출력:\", tuple(_v(torch.randn(2, 3, 32, 32)).shape),\n",
