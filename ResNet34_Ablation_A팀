    "# ── 4. 학습 / 평가 함수 ───────────────────────────────────────\n",
    "@torch.no_grad()\n",
    "def evaluate(model, loader):\n",
    "    model.eval()\n",
    "    loss_sum, correct, total = 0.0, 0, 0\n",
    "    crit = nn.CrossEntropyLoss(reduction=\"sum\")\n",
    "    for x, y in loader:\n",
    "        x, y = x.to(device), y.to(device)\n",
    "        out = model(x)\n",
    "        loss_sum += crit(out, y).item()\n",
    "        correct  += (out.argmax(1) == y).sum().item()\n",
    "        total    += y.size(0)\n",
    "    return loss_sum/total, correct/total\n",
    "\n",
    "def train_one_epoch(model, loader, optimizer):\n",
    "    model.train()\n",
    "    crit = nn.CrossEntropyLoss()\n",
    "    loss_sum, correct, total = 0.0, 0, 0\n",
    "    for x, y in loader:\n",
    "        x, y = x.to(device), y.to(device)\n",
    "        optimizer.zero_grad()\n",
    "        out = model(x)\n",
    "        loss = crit(out, y)\n",
    "        loss.backward()\n",
    "        optimizer.step()\n",
    "        loss_sum += loss.item()*y.size(0)\n",
    "        correct  += (out.argmax(1) == y).sum().item()\n",
    "        total    += y.size(0)\n",
    "    return loss_sum/total, correct/total\n",
    "\n",
    "def make_optimizer(model, name=\"sgd\", lr=0.1, weight_decay=5e-4):\n",
    "    if name == \"sgd\":\n",
    "        return torch.optim.SGD(model.parameters(), lr=lr,\n",
    "                               momentum=0.9, weight_decay=weight_decay)\n",
    "    elif name == \"adam\":\n",
    "        return torch.optim.Adam(model.parameters(), lr=lr,\n",
    "                                weight_decay=weight_decay)\n",
    "    raise ValueError(name)\n",
    "\n",
    "def fit(model, train_loader, test_loader, epochs=10,\n",
    "        optimizer_name=\"sgd\", lr=0.1, use_scheduler=True, log=True):\n",
    "    model = model.to(device)\n",
    "    optimizer = make_optimizer(model, optimizer_name, lr)\n",
    "    scheduler = (torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=epochs)\n",
    "                 if use_scheduler else None)\n",
    "    history = {\"train_acc\": [], \"test_acc\": [], \"train_loss\": [], \"test_loss\": []}\n",
    "    best_acc = 0.0\n",
    "    t0 = time.time()\n",
    "    for ep in range(1, epochs+1):\n",
    "        tr_loss, tr_acc = train_one_epoch(model, train_loader, optimizer)\n",
    "        te_loss, te_acc = evaluate(model, test_loader)\n",
    "        if scheduler: scheduler.step()\n",
    "        best_acc = max(best_acc, te_acc)\n",
    "        history[\"train_acc\"].append(tr_acc); history[\"test_acc\"].append(te_acc)\n",
    "        history[\"train_loss\"].append(tr_loss); history[\"test_loss\"].append(te_loss)\n",
    "        if log:\n",
    "            print(f\"  epoch {ep:2d}/{epochs} | train acc {tr_acc:.3f} \"\n",
    "                  f\"| test acc {te_acc:.3f} | best {best_acc:.3f}\")\n",
    "    elapsed = time.time()-t0\n",
    "    return {\"history\": history, \"best_acc\": best_acc,\n",
    "            \"final_acc\": history[\"test_acc\"][-1],\n",
    "            \"params\": count_params(model), \"time_sec\": elapsed}\n"
   ]
